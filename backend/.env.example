# Copy to `.env` and adjust as needed for local development.

APP_NAME="AI Incident Investigator"
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/incident_investigator.db

# LLM provider for the agent pipeline: "anthropic" or "gemini".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
