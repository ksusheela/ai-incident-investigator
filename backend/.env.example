# Copy to `.env` and adjust as needed for local development.

APP_NAME="AI Incident Investigator"
APP_ENV=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/incident_investigator.db

# Comma-separated browser origins allowed to call the API (must match
# where the frontend is actually served from, or the browser blocks it).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# LLM provider for the agent pipeline: "anthropic" or "gemini".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
